echo "Hello from JVE"

html {
  <h1>JVE works!</h1>
  <p>This page was created with JVE.</p>
}

js {
  console.log("JavaScript injected by JVE");
}

# The code(...) wrapper is required for Openwindow.
Openwindow(js code(<html><body><h1>Hello from a JVE window</h1><p>This HTML is running in a new window.</p></body></html>))
